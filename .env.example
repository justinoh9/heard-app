EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Music search runs on the iTunes Search API (src/music/itunes.ts), which is
# keyless — nothing to set here for search + artwork + previews to work.

# Last.fm (optional) — layers a popularity ranking onto iTunes results
# (src/music/lastfm.ts) using listener counts. The key is a plain public query
# param (no OAuth, no secret): grab one at https://www.last.fm/api/account/create
# Leave blank to disable enrichment; results then keep Apple's relevance order.
EXPO_PUBLIC_LASTFM_API_KEY=

# Google AdSense (optional, web only) — display ads. Both stay blank until the
# site is approved at https://adsense.google.com; with either unset, no ad
# script loads and no ad UI renders. CLIENT is the ca-pub-… publisher id;
# SLOT_FEED / SLOT_BROWSE are the ad-unit ids for the Feed and Browse
# placements (created in the AdSense dashboard). Remember to also fill in
# public/ads.txt on approval.
EXPO_PUBLIC_ADSENSE_CLIENT=
EXPO_PUBLIC_ADSENSE_SLOT_FEED=
EXPO_PUBLIC_ADSENSE_SLOT_BROWSE=

# Spotify (optional) — only the "recently played" import tray + the alternate
# SpotifyCatalog use these; search runs on iTunes and needs nothing here.
#
# The client ID is safe to publish: the user-OAuth flow (src/music/spotify-auth.ts)
# is PKCE, which is designed for clients that cannot keep a secret. Grab one at
# https://developer.spotify.com/dashboard
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
#
# There is NO client-secret variable, on purpose. EXPO_PUBLIC_* values are inlined
# into the app bundle, so any secret here is published to everyone who opens the
# site — which is exactly what happened before Phase 4. SpotifyCatalog now takes
# its token only from the spotify-token Edge Function, so if you re-enable it,
# deploy that function (supabase/functions/spotify-token/README.md) and set:
EXPO_PUBLIC_SPOTIFY_TOKEN_URL=
